{
  "name": "dsh-game-hub",
  "version": "1.0.0",
  "description": "游戏中心 —— 一个悬浮入口装下 11 款游戏：三国志战略、诺基亚弹珠台，以及复刻的贪吃蛇/俄罗斯方块/打砖块/2048/扫雷/小蜜蜂/五子棋/象棋/掼蛋。DeepSeek Harness 插件。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "game",
    "games",
    "arcade",
    "minigame"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "dist/client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tools/import-legacy.mjs && node tools/build.mjs",
    "test": "node tools/test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhanghao3693/dsh-game-hub.git"
  },
  "homepage": "https://github.com/zhanghao3693/dsh-game-hub#readme",
  "bugs": {
    "url": "https://github.com/zhanghao3693/dsh-game-hub/issues"
  },
  "author": "zhanghao3693",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "icon": "./icon.svg"
}
